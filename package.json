{
  "name": "frontend-architecture-performance-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Frontend platform for module boundaries, performance budgets, and measurement.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w platform-shell",
    "build": "npm run build -w platform-shell",
    "check:build": "vite-node --config apps/platform/vite.config.ts scripts/check-shell-budgets.ts",
    "preview": "npm run preview -w platform-shell",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "vitest run benchmarks/harness.test.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
